
font=UbuntuMono Nerd Font:size=14
dpi-aware=no
pad=10x10
[scrollback]
indicator-position= none
[cursor]

style=beam
color=ff00d4 ff00d4
# blink=no
 beam-thickness=1
# underline-thickness=<font underline thickness>

[colors]
foreground=d1ff00

#ff00d4
#ff64e5 
#ff26db
#ed08ff



#ae00ff
#ff00d0
#ff0051
#ff2e00
#ffae00
#d1ff00


background=260d32
alpha=0.80
regular0=181a29
regular1=F07178
regular2=cdea9f
regular3=ffd47e
regular4=93bbff
regular5=d3a7ee
regular6=98e4ff
regular7=bfd5de
bright0=282a40
bright1=eb7f84
bright2=e0ffad
bright3=ffee7e
bright4=a3c5ff
bright5=d6afed
bright6=98e4ff
bright7=d1e5ed
selection-foreground=ffffff
selection-background=ae00ff






[url]
launch=xdg-open ${url}
label-letters=sadfjklewcmpgh
osc8-underline=url-mode
protocols=http, https, ftp, ftps, file, gemini, gopher
uri-characters=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.,~:;/?#@!$&%*+="'()[]
#show-urls-launch=Control+Shift+u
osc8-underline=url-mode
